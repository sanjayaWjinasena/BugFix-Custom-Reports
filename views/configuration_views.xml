<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_configuration" model="ir.actions.act_window">
    <field name="name">Configuration</field>
    <field name="res_model">configuration</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_configuration_2" model="ir.actions.act_window">
    <field name="name">configuration</field>
    <field name="res_model">configuration</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_configuration_form" model="ir.ui.view">
      <field name="name">Default form view for configuration</field>
      <field name="model">configuration</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Configuration">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
    <field name="active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_96a3e2">
      <group name="studio_group_96a3e2_left"/>
      <group name="studio_group_96a3e2_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <!-- STRIPPED field message_follower_ids not on configuration -->
    <!-- STRIPPED field message_ids not on configuration -->
    <!-- STRIPPED field activity_ids not on configuration -->
  </div>
</form>
      </field>
    </record>
    <record id="view_configuration_list" model="ir.ui.view">
      <field name="name">Default list view for configuration</field>
      <field name="model">configuration</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="sequence" widget="handle"/>
  <field name="name"/>
</tree>
      </field>
    </record>
    <record id="view_configuration_search" model="ir.ui.view">
      <field name="name">Default search view for configuration</field>
      <field name="model">configuration</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_configuration" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
</odoo>
