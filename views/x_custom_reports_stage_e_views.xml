<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Custom-Reports: Phase E - 3 views for x_custom_reports_stage -->
<odoo>
  <data>
    <record id="view_8641_default_form_view_for_x_custom_reports_stage_e" model="ir.ui.view">
      <field name="name">Default form view for x_custom_reports_stage</field>
      <field name="model">x_custom_reports_stage</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Custom Reports Stages">
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_a6d825">
      <group name="studio_group_a6d825_left"/>
      <group name="studio_group_a6d825_right"/>
    </group>
  </sheet>
</form>
      </field>
    </record>

    <record id="view_8640_default_list_view_for_x_custom_reports_stage_e" model="ir.ui.view">
      <field name="name">Default list view for x_custom_reports_stage</field>
      <field name="model">x_custom_reports_stage</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree editable="bottom">
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree>
      </field>
    </record>

    <record id="view_8642_default_search_view_for_x_custom_reports_stage_e" model="ir.ui.view">
      <field name="name">Default search view for x_custom_reports_stage</field>
      <field name="model">x_custom_reports_stage</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="x_name"/>
</search>
      </field>
    </record>

  </data>
</odoo>