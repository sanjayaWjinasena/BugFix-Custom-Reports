<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_calendar_vie_b1e493b3_beb6_4061_b3c6_62c1955a90c5" model="ir.ui.view">
    <field name="name">Default calendar view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_calendar_vie_b1e493b3-beb6-4061-b3c6-62c1955a90c5</field>
    <field name="type">calendar</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <calendar date_start="x_studio_date" create_name_field="x_name"/>
    </field>
  </record>
  <record id="ported_default_form_view_fo_dda3da64_0fb4_40e3_aa0b_39b61094f559" model="ir.ui.view">
    <field name="name">Default form view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_form_view_fo_dda3da64-0fb4-40e3-aa0b-39b61094f559</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="x_studio_stage_id" widget="statusbar" options="{'clickable': '1'}"/>
        </header>
        <sheet string="Custom Reports">
          <field name="x_studio_kanban_state" widget="state_selection"/>
          <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="x_active"/>
          <field name="x_active" invisible="1"/>
          <field class="oe_avatar" widget="image" name="x_studio_image"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_b38601">
            <group name="studio_group_b38601_left">
              <field name="x_studio_partner_id"/>
              <field name="x_studio_partner_phone" widget="phone" options="{'enable_sms': True}"/>
              <field name="x_studio_partner_email" widget="email"/>
              <field name="x_studio_date"/>
              <field name="x_studio_date_start" string="Dates" widget="daterange" options="{'end_date_field': 'x_studio_date_stop'}"/>
              <field name="x_studio_date_stop" invisible="1"/>
            </group>
            <group name="studio_group_b38601_right">
              <field name="x_studio_user_id" widget="many2one_avatar_user"/>
              <field name="x_studio_currency_id" invisible="1"/>
              <field name="x_studio_value"/>
              
              <field name="x_studio_company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
            </group>
          </group>
          <group>
            
          </group>
          <notebook>
            <page string="Details" name="lines">
              
            </page>
          </notebook>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_gantt_view_f_57b95077_4af3_449c_a94a_1395b50d1106" model="ir.ui.view">
    <field name="name">Default gantt view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_gantt_view_f_57b95077-4af3-449c-a94a-1395b50d1106</field>
    <field name="type">gantt</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <gantt date_start="x_studio_date_start" date_stop="x_studio_date_stop"/>
    </field>
  </record>
  <record id="ported_default_graph_view_f_94706f6f_a627_4650_944f_17a5728d540b" model="ir.ui.view">
    <field name="name">Default graph view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_graph_view_f_94706f6f-a627-4650-944f-17a5728d540b</field>
    <field name="type">graph</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <graph sample="1">
        <field name="x_studio_value" type="measure"/>
        <field name="create_date" type="row"/>
      </graph>
    </field>
  </record>
  <record id="ported_default_kanban_view__54a18f4f_e5ed_4ad3_8b69_ac80f382eac5" model="ir.ui.view">
    <field name="name">Default kanban view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_kanban_view__54a18f4f-e5ed-4ad3-8b69-ac80f382eac5</field>
    <field name="type">kanban</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <kanban default_group_by="x_studio_stage_id" default_order="x_studio_priority desc, x_studio_sequence asc, id desc">
        <field name="x_color"/>
        <field name="x_studio_user_id" widget="many2one_avatar_user"/>
        <field name="x_studio_currency_id"/>
        <progressbar field="x_studio_kanban_state" colors="{&quot;normal&quot;: &quot;200&quot;, &quot;done&quot;: &quot;success&quot;, &quot;blocked&quot;: &quot;danger&quot;}" sum_field="x_studio_value"/>
        <templates>
          <t t-name="kanban-box">
            <div t-attf-class="#{!selection_mode ? kanban_color(record.x_color.raw_value) : ''} oe_kanban_global_click">
              <field class="o_kanban_image" name="x_studio_image" widget="image" options="{&quot;zoom&quot;: true, &quot;background&quot;: true, &quot;preventClicks&quot;: false}"/>
              <div class="o_kanban_record_details">
                <div class="o_kanban_record_top" name="studio_auto_kanban_top">
                  <div class="o_kanban_record_headings" name="studio_auto_kanban_headings">
                    <field name="x_studio_priority" widget="boolean_favorite" nolabel="1"/>
                    <strong class="o_kanban_record_title" name="studio_auto_kanban_title">
                      <field name="x_name"/>
                    </strong>
                  </div>
                  <div class="o_dropdown_kanban dropdown">
                    <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" data-display="static" href="#" aria-label="Dropdown Menu" title="Dropdown Menu">
                      <span class="fa fa-ellipsis-v"/>
                    </a>
                    <div class="dropdown-menu" role="menu">
                      <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                      <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                      <ul class="oe_kanban_colorpicker" data-field="x_color"/>
                    </div>
                  </div>
                </div>
                <div class="o_kanban_record_body" name="studio_auto_kanban_body">
                  
                </div>
                <div class="o_kanban_record_bottom" name="studio_auto_kanban_bottom">
                  <div class="oe_kanban_bottom_left" name="studio_auto_kanban_bottom_left">
                    <field name="x_studio_value"/>
                  </div>
                  <div class="oe_kanban_bottom_right" name="studio_auto_kanban_bottom_right">
                    <field name="x_studio_kanban_state" widget="state_selection"/>
                    <t t-set="unassigned" t-translation="on">Unassigned</t>
                    <img t-att-src="kanban_image('res.users', 'avatar_128', record.x_studio_user_id.raw_value)" t-att-title="record.x_studio_user_id.value || unassigned" t-att-alt="record.x_studio_user_id.value" class="oe_kanban_avatar o_image_24_cover float-right"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="ported_default_list_view_fo_272eacb6_6b73_443a_8b49_86b455fc6f26" model="ir.ui.view">
    <field name="name">Default list view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_list_view_fo_272eacb6-6b73-443a-8b49-86b455fc6f26</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_name"/>
        <field name="x_studio_partner_id"/>
        <field name="x_studio_user_id" widget="many2one_avatar_user"/>
        <field name="x_studio_company_id" groups="base.group_multi_company"/>
        <field name="x_studio_currency_id" invisible="1"/>
        <field name="x_studio_value" sum="Total"/>
        
        <field name="x_color" widget="color_picker"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_map_view_for_45ed0a8d_a481_4c49_8a88_00fd7896909a" model="ir.ui.view">
    <field name="name">Default map view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_map_view_for_45ed0a8d-a481-4c49-8a88-00fd7896909a</field>
    <field name="type">map</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <map res_partner="x_studio_partner_id">
        <field name="x_studio_partner_id" string="Partner"/>
      </map>
    </field>
  </record>
  <record id="ported_default_pivot_view_f_0ce2e391_89fd_41d9_9085_c0403f9be001" model="ir.ui.view">
    <field name="name">Default pivot view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_pivot_view_f_0ce2e391-89fd-41d9-9085-c0403f9be001</field>
    <field name="type">pivot</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <pivot sample="1">
        <field name="x_studio_value" type="measure"/>
        <field name="x_studio_stage_id" type="col"/>
        <field name="x_studio_date" type="row"/>
      </pivot>
    </field>
  </record>
  <record id="ported_default_search_view__730cfc74_f6e5_4962_a82a_dc9dc6399cb2" model="ir.ui.view">
    <field name="name">Default search view for x_custom_reports</field>
    <field name="model">x_custom_reports</field>
    <field name="key">studio_customization.default_search_view__730cfc74-f6e5-4962-a82a-dc9dc6399cb2</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <field name="x_studio_partner_id" operator="child_of"/>
        <field name="x_studio_user_id"/>
        
        <filter string="My Custom Reports" name="my_x_custom_reports" domain="[['x_studio_user_id', '=', uid]]"/>
        <separator/>
        <filter date="x_studio_date" name="studio_filter_date" string="Date"/>
        <filter date="x_studio_date_start" name="studio_filter_date_start" string="Start Date"/>
        <filter date="x_studio_date_stop" name="studio_filter_date_stop" string="End Date"/>
        <separator/>
        <filter string="Archived" name="archived_x_custom_reports" domain="[['x_active', '=', False]]"/>
        <separator/>
        <filter name="groupby_x_partner" string="Partner" context="{'group_by': 'x_studio_partner_id'}" domain="[]"/>
        <filter name="groupby_x_user" string="Responsible" context="{'group_by': 'x_studio_user_id'}" domain="[]"/>
        <filter name="x_studio_stage_id" string="Stage" context="{'group_by': 'x_studio_stage_id'}" domain="[]"/>
      </search>
    </field>
  </record>
</odoo>
